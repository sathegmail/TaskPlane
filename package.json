{
  "name": "taskplane",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:all": "tsc --noEmit && jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^react-native/setup-env$": "<rootDir>/node_modules/react-native/src/setup-env.js",
      "^react-native/react-private-interface$": "<rootDir>/node_modules/react-native/src/react-private-interface.js",
      "^react-native/asset-registry$": "<rootDir>/node_modules/react-native/src/asset-registry.js",
      "^react-native/unstable-internals-do-not-use$": "<rootDir>/node_modules/react-native/src/unstable-internals-do-not-use.js"
    }
  },
  "private": true
}
